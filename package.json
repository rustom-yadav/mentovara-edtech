{
  "name": "mentovara",
  "version": "1.0.0",
  "description": "Mentovara EdTech Platform - Monorepo",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:mongoDB": "pnpm db:up && pnpm dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build",
    "start:client": "pnpm --filter client start",
    "start:server": "pnpm --filter server start",
    "lint": "pnpm -r lint",
    "lint:client": "pnpm --filter client lint",
    "lint:server": "pnpm --filter server lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9"
  }
}
