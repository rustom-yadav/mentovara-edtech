# Docker Compose automatically reads this file to resolve variables inside docker-compose.yml.
# These variables are required during the BUILD step for the Next.js client.

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

