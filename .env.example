# ==============================================================================
# ROOT .env FILE (Used by Docker Compose for Build & Runtime Arguments)
# ==============================================================================
# Docker Compose automatically reads this file to resolve variables inside docker-compose.yml.
# These variables are required during the BUILD and RUNTIME steps for the Next.js client.

# For Docker internal networking (Allows Next.js proxy to reach the backend container)
INTERNAL_BACKEND_URL=http://server:8000 

# For browser to directly access the backend API (Bypasses Next.js proxy)
# Locally: http://localhost:8000 | Production: https://api.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000 

NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
