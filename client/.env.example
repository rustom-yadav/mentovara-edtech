# ==============================================================================
# CLIENT .env FILE (For Local Development without Docker)
# ==============================================================================

# The actual destination of the backend API (Bypasses Next.js proxy)
# Locally: http://localhost:8000 | Production: https://api.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
