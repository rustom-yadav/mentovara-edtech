# ==========================================
# 0. BASE STAGE
# ==========================================
FROM node:24-alpine AS base
# Enable pnpm across all stages
RUN corepack enable pnpm

# ==========================================
# 1. DEPENDENCIES STAGE
# ==========================================
FROM base AS deps
WORKDIR /app

# Copy workspace configuration and lockfiles first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json server/
COPY client/package.json client/

# Install all dependencies. This layer will be heavily cached by Docker
# and will only re-run if package.json or pnpm-lock.yaml changes.
RUN pnpm install --frozen-lockfile

# ==========================================
# 2. BUILDER STAGE
# ==========================================
FROM base AS builder
WORKDIR /app

# Copy node_modules and setup from the deps stage (preserves pnpm symlinks)
COPY --from=deps /app ./

# Copy root configuration files needed by ESLint/Prettier during Next.js build
COPY .prettierrc .prettierignore ./

# Copy ONLY the client source code. 
# (This prevents server code changes from unnecessarily invalidating the client build cache)
COPY client/ ./client/

# Define build arguments for Next.js public variables
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_RAZORPAY_KEY_ID


# Make them available as environment variables during the build
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_RAZORPAY_KEY_ID=$NEXT_PUBLIC_RAZORPAY_KEY_ID


# Build the client (Next.js will generate a standalone folder)
RUN pnpm --filter client build

# ==========================================
# 3. PRODUCTION RUNNER STAGE
# ==========================================
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
# Opt out of Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security best practices
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 --ingroup nodejs nextjs

# The standalone build replicates the monorepo structure.
# We copy the root node_modules and the client folder from standalone.
COPY --from=builder --chown=nextjs:nodejs /app/client/.next/standalone ./

# Explicitly create and give ownership of the cache folder to prevent permission issues
RUN mkdir -p /app/client/.next/cache && chown -R nextjs:nodejs /app/client/.next/cache

# Copy static files (standalone doesn't copy public or static by default)
COPY --from=builder --chown=nextjs:nodejs /app/client/public ./client/public
COPY --from=builder --chown=nextjs:nodejs /app/client/.next/static ./client/.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
# Ensure hostname is 0.0.0.0 to accept connections from outside the container
ENV HOSTNAME="0.0.0.0"

# Run the standalone server generated by Next.js
CMD ["node", "client/server.js"]
