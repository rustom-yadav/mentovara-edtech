PORT=8000

# ----------------------------------------------------
# DATABASE CONNECTION (CHOOSE ONLY ONE)
# ----------------------------------------------------
# Option A: MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.v1xsdpe.mongodb.net/

# Option B: Local Docker MongoDB (Requires running `pnpm db:up` in root)
MONGO_URI=mongodb://root:secret@127.0.0.1:27017/?authSource=admin

ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Gmail SMTP Configuration (use App Password from https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_gmail@gmail.com
FROM_NAME=Mentovara
 
# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# MongoDB Local Docker Initialization (Optional for local dev container)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret
